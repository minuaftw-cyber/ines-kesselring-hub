# Copy this file to .env for local development: cp .env.example .env
# Never commit .env — it is listed in .gitignore.

DJANGO_DEBUG=1
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Leave empty to use SQLite (db.sqlite3). For PostgreSQL:
# DATABASE_URL=postgres://ines:ines@localhost:5432/ines
DATABASE_URL=

# Address the browser uses to load uploaded images.
MEDIA_PUBLIC_BASE_URL=http://localhost:8000

# YouTube sync. The channel ID is public; the API key is optional
# (without it, use: python manage.py sync_youtube --rss).
YOUTUBE_CHANNEL_ID=UCAweDfCuXKD6_E5gjNizQSw
YOUTUBE_API_KEY=

# Password for the demo staff/member accounts created by: seed_demo --with-users
DEMO_PASSWORD=
